# ── Kimi Coding API (必填，二选一) ─────────────────────────────────────────────
# 支持 Kimi Coding (Anthropic 格式) 和 Moonshot (OpenAI 格式)，代码自动探测
KIMI_API_KEY=your_kimi_api_key_here
KIMI_API_BASE=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding

# ── OpenRouter Fallback (可选) ─────────────────────────────────────────────────
# 当 Kimi API 不可用时自动切换
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# ── Telegram Bot (用于审阅推送和数据报告) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── 运行配置 ────────────────────────────────────────────────────────────────────
# 逗号分隔，留空表示运行 accounts.json 中所有账号
ACTIVE_ACCOUNTS=petery,pyy
